# Variables de entorno para OpenClaw Livestock Assistant

# Clave de API de OpenAI (requerida para el asistente IA)
OPENAI_API_KEY=your_openai_api_key_here

# Modelo de OpenAI a utilizar (por defecto: gpt-4o)
OPENAI_MODEL=gpt-4o

# Puerto del servidor (por defecto: 3000)
PORT=3000

# Entorno de ejecución
NODE_ENV=development
