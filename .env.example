# OpenClaw Livestock Assistant — Environment Variables

# ─────────────────────────────────────────────
# AI Provider Selection
# ─────────────────────────────────────────────

# Explicitly select a provider: openai | anthropic | google
# If not set, the assistant auto-detects from whichever API key is present.
# AI_PROVIDER=openai

# Override the model ID for the selected provider.
# If not set, the default model for that provider is used.
# AI_MODEL=gpt-4o

# ─────────────────────────────────────────────
# Provider API Keys (set at least one)
# ─────────────────────────────────────────────

# OpenAI  (default model: gpt-4o)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic / Claude  (default model: claude-3-5-sonnet-20241022)
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini  (default model: gemini-1.5-pro)
# https://aistudio.google.com/app/apikey
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────

# HTTP port for the Express API server (default: 3000)
PORT=3000

# Runtime environment
NODE_ENV=development
